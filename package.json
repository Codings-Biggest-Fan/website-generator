{
  "name": "website-generator",
  "private": true,
  "version": "1.0.0",
  "description": "MVRT.com (FRC Team 115) Visual Website Generator & Maintainer App",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "generate-site": "node scripts/generate-site.mjs",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:start": "npm run build && electron ."
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^45.4.1"
  }
}
